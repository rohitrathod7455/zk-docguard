# =============================================================================
# ZK-DocGuard Environment Variables
# Copy to .env and fill in the values
# =============================================================================

# ---- General ----
NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgresql://zkdocguard:zkdocguard@localhost:5432/zkdocguard

# ---- API ----
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# ---- Blockchain ----
HARDHAT_NETWORK=localhost
# Private key for contract deployment (DO NOT commit real keys)
DEPLOYER_PRIVATE_KEY=
# Polygon Amoy (chainId 80002)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
# Sepolia (chainId 11155111)
SEPOLIA_RPC=https://rpc.sepolia.org
# Etherscan / Polygonscan verification
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=

# ---- IPFS ----
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
# Optional: Pinata for pinning (Phase 11)
PINATA_JWT=
PINATA_GATEWAY_URL=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_IPFS_GATEWAY=http://localhost:8080

# ---- Gas reporting ----
REPORT_GAS=false
