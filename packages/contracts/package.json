{
  "name": "@zk-docguard/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"src/**/*.sol\" && eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean && rimraf dist coverage",
    "coverage": "hardhat coverage",
    "export-abi": "hardhat run scripts/export-artifacts.ts",
    "deploy:hardhat": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@openzeppelin/contracts": "^5.1.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "hardhat-gas-reporter": "^2.2.2",
    "solidity-coverage": "^0.8.14",
    "solhint": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/node": "^22.10.1",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "@types/chai": "^4.3.20"
  }
}
